# Copy to backend/.env (gitignored). All values optional; defaults shown.
# DATABASE_URL=sqlite:////app/var/fitness.db
USER_TZ=Europe/Vienna
DEFAULT_GYM_NAME=Main gym
# STRONG_DEFAULT_WEIGHT_UNIT=kg
# STRONG_DEFAULT_DISTANCE_UNIT=km

# Claude advisor (step 6, docs/api/coach.md). Without a key consultations wait as `awaiting_key`
# (nothing crashes); the key is only ever read from the environment and never logged.
# ANTHROPIC_API_KEY=            # https://console.anthropic.com/ (sk-ant-...)
# ADVISOR_MODEL=claude-opus-5-5
# ADVISOR_DRY_RUN=false         # true: build + store the input of every consultation, never call
# ADVISOR_MAX_TOKENS=16000
# ADVISOR_MAX_RETRIES=3         # SDK retries (429 / 5xx / connection) with exponential backoff
# ADVISOR_WEEKLY_TIME=20:00     # Sunday weekly review (scheduler_tz); needs SCHEDULER_ENABLED=true
# ADVISOR_TRIGGER_TIME=18:30    # daily batch of open advisor triggers (not Sundays)
# ADVISOR_OUTCOME_TIME=04:15    # daily outcome check of changes applied 21-28 days ago
# Budget guards (max_calls_per_week, max_ask_per_day), the approval mode and the prices live in
# the engine config under `advisor:` (PUT /api/v1/coach/settings, `engine config set advisor.x`).

# STRONG_MAX_DURATION_H=4       # longer Strong sessions are stored without duration
# API_TOKEN=                    # bearer token for the write endpoints (bodyweight); unset => 503

# Garmin (step 2). Personal API key: https://connect.garmin.com/app/settings/personalApiToken
# GARMIN_PERSONAL_API_KEY=
# GARMIN_SOURCE=auto            # personal_api | garminconnect | auto
# GARMIN_EMAIL=                 # fallback only (python-garminconnect); never needed with a key
# GARMIN_PASSWORD=
# GARMIN_REQUEST_INTERVAL_S=1.0
# SCHEDULER_ENABLED=false       # true on the server: nightly 03:30 + 4 daytime Garmin syncs
