# Automatic HTTPS (Let's Encrypt) for $DOMAIN; open ports 80/443 in the OCI security list
# and in the VM firewall (iptables/firewalld) first.
#
# Everything goes to the backend (backend:8000). Caddy adds the real client IP as X-Forwarded-For
# (the backend's failed-token throttle relies on it).
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		-Server
	}

	reverse_proxy backend:8000
}
